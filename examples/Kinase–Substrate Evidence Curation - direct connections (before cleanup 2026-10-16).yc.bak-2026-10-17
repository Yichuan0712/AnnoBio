        "inputs": {
          "code": "import requests\n\n\ndef process(df):\n    \"\"\"Split pairs by whether both protein names resolve in UniProt.\"\"\"\n    def uniprot_candidates(name):\n        query = str(name or \"\").strip()\n        if not query:\n            return []\n        try:\n            response = requests.get(\n                \"https://rest.uniprot.org/uniprotkb/search\",\n                params={\n                    \"query\": f'(protein_name:\"{query}\")',\n                    \"format\": \"json\",\n                    \"fields\": \"accession,protein_name,gene_names,organism_name\",\n                    \"size\": 5,\n                },\n                timeout=15,\n            )\n            response.raise_for_status()\n        except requests.RequestException:\n            return []\n        candidates = []\n        for item in response.json().get(\"results\", []):\n            protein = item.get(\"proteinDescription\", {})\n            recommended = protein.get(\"recommendedName\", {}).get(\"fullName\", {}).get(\"value\", \"\")\n            genes = \", \".join(\n                gene.get(\"geneName\", {}).get(\"value\", \"\")\n                for gene in item.get(\"genes\", [])\n                if gene.get(\"geneName\", {}).get(\"value\")\n            )\n            candidates.append({\n                \"accession\": item.get(\"primaryAccession\", \"\"),\n                \"protein_name\": recommended,\n                \"gene_names\": genes,\n                \"organism\": item.get(\"organism\", {}).get(\"scientificName\", \"\"),\n            })\n        return candidates\n\n    out = df.copy()\n    out[\"kinase_candidates\"] = out[\"kinase\"].map(uniprot_candidates)\n    out[\"substrate_candidates\"] = out[\"substrate\"].map(uniprot_candidates)\n    has_candidates = out[\"kinase_candidates\"].map(bool) & out[\"substrate_candidates\"].map(bool)\n    return {\n        \"ready_for_uniprot_matching\": out.loc[has_candidates].reset_index(drop=True),\n        \"needs_name_rewrite\": out.loc[~has_candidates].reset_index(drop=True),\n    }",
