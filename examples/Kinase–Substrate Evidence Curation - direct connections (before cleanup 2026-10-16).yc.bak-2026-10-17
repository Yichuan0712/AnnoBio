        "inputs": {
          "code": "def process(df):\n    # Split confirmed kinase-substrate pairs by whether the article full text is available.\n    # Each returned key becomes a named branch on the Process node.\n    out = pd.DataFrame({\n        \"PMID\": df[\"Input: PMID\"],\n        \"Title\": df[\"Input: Title\"],\n        \"FullText\": df[\"Input: FullText\"],\n        \"kinase\": df[\"Input: kinase\"],\n        \"substrate\": df[\"Input: substrate\"],\n    })\n\n    def pick(block, index):\n        lines = [line for line in str(block).splitlines() if line.strip()]\n        position = int(float(index))\n        return lines[position] if 0 <= position < len(lines) else \"\"\n\n    def accession(line):\n        parts = [part.strip() for part in str(line).split(\"|\")]\n        return parts[1] if len(parts) > 1 else \"\"\n\n    out[\"kinase_accession\"] = [\n        accession(pick(block, index))\n        for block, index in zip(df[\"Input: kinase_candidates\"], df[\"Output: kinase_index\"])\n    ]\n    out[\"substrate_accession\"] = [\n        accession(pick(block, index))\n        for block, index in zip(df[\"Input: substrate_candidates\"], df[\"Output: substrate_index\"])\n    ]\n    out[\"phosphosite\"] = \"\"\n\n    has_full_text = out[\"FullText\"].fillna(\"\").astype(str).str.strip().ne(\"\")\n    return {\n        \"needs_full_text_site_extraction\": out.loc[has_full_text].reset_index(drop=True),\n        \"missing_full_text\": out.loc[~has_full_text].reset_index(drop=True),\n    }",
