            "content": "{\"found\":true,\"nodeId\":\"n_1790200002192_117358448\",\"type\":\"process\",\"title\":\"Resolve chosen accessions\",\"upstream\":[{\"connection\":\"data\",\"nodeId\":\"n_1790200001781_114103739\",\"type\":\"run\",\"title\":\"Generate\"}],\"downstream\":[{\"connection\":\"data\",\"nodeId\":\"n_1790200002466_119528254\",\"type\":\"run\",\"title\":\"Generate\"}],\"ports\":{\"inputs\":[{\"id\":\"df\",\"source\":{\"nodeId\":\"n_1790200001781_114103739\",\"type\":\"run\",\"title\":\"Generate\"}},{\"id\":\"+\",\"source\":null}],\"outputs\":[{\"id\":\"needs_full_text_site_extraction\",\"readBy\":[{\"nodeId\":\"n_1790200002466_119528254\",\"portId\":\"input\"}]},{\"id\":\"missing_full_text\",\"readBy\":[]}]},\"details\":{\"code\":\"def process(df):\\n    # Split confirmed kinase-substrate pairs by whether the article full text is available.\\n    # Each returned key becomes a named branch on the Process node.\\n    out = pd.DataFrame({\\n        \\\"PMID\\\": df[\\\"Input: PMID\\\"],\\n        \\\"Title\\\": df[\\\"Input: Title\\\"],\\n        \\\"FullText\\\": df[\\\"Input: FullText\\\"],\\n        \\\"kinase\\\": df[\\\"Input: kinase\\\"],\\n        \\\"substrate\\\": df[\\\"Input: substrate\\\"],\\n    })\\n\\n    def pick(block, index):\\n        lines = [line for line in str(block).splitlines() if line.strip()]\\n        position = int(float(index))\\n        return lines[position] if 0 <= position < len(lines) else \\\"\\\"\\n\\n    def accession(line):\\n        parts = [part.strip() for part in str(line).split(\\\"|\\\")]\\n        return parts[1] if len(parts) > 1 else \\\"\\\"\\n\\n    out[\\\"kinase_accession\\\"] = [\\n        accession(pick(block, index))\\n        for block, index in zip(df[\\\"Input: kinase_candidates\\\"], df[\\\"Output: kinase_index\\\"])\\n    ]\\n    out[\\\"substrate_accession\\\"] = [\\n        accession(pick(block, index))\\n        for block, index in zip(df[\\\"Input: substrate_candidates\\\"], df[\\\"Output: substrate_index\\\"])\\n    ]\\n    out[\\\"phosphosite\\\"] = \\\"\\\"\\n\\n    has_full_text = out[\\\"FullText\\\"].fillna(\\\"\\\").astype(str).str.strip().ne(\\\"\\\")\\n    return {\\n        \\\"needs_full_text_site_extraction\\\": out.loc[has_full_text].reset_index(drop=True),\\n        \\\"missing_full_text\\\": out.loc[~has_full_text].reset_index(drop=True),\\n    }\",\"primaryInput\":{\"nodeId\":\"n_1790200001781_114103739\",\"type\":\"run\",\"title\":\"Generate\"},\"inputs\":[{\"nodeId\":\"n_1790200001781_114103739\",\"type\":\"run\",\"title\":\"Generate\",\"alias\":\"df\"}],\"unconnectedInputs\":[],\"availableInputs\":[{\"nodeId\":\"n_1790200000137_101084903\",\"type\":\"dataset\",\"title\":\"kinase_abstracts\",\"alias\":\"df_kinase_abstracts\",\"isInput\":false},{\"nodeId\":\"n_ui_check_pairs_reference\",\"type\":\"dataset\",\"title\":\"Pairs reference (demo)\",\"alias\":\"df_pairs_reference_demo\",\"isInput\":false},{\"nodeId\":\"n_ui_check_uniprot_reference\",\"type\":\"dataset\",\"title\":\"UniProt reference (demo)\",\"alias\":\"df_uniprot_reference_demo\",\"isInput\":false},{\"nodeId\":\"n_ui_check_sites_reference\",\"type\":\"dataset\",\"title\":\"Sites reference (demo)\",\"alias\":\"df_sites_reference_demo\",\"isInput\":false},{\"nodeId\":\"n_1792086730990_470196811\",\"type\":\"dataset\",\"title\":\"kinase_abstracts v2\",\"alias\":\"df_kinase_abstracts_v2\",\"isInput\":false},{\"nodeId\":\"n_1790200000411_103254709\",\"type\":\"run\",\"title\":\"Generate\",\"alias\":\"df_extract_kinase_substrate_pairs\",\"isInput\":false},{\"nodeId\":\"n_1790200000822_106509418\",\"type\":\"process\",\"title\":\"Tidy extracted pairs\",\"branch\":\"result\",\"alias\":\"df_tidy_extracted_pairs\",\"isInput\":false},{\"nodeId\":\"n_1790200001096_108679224\",\"type\":\"run\",\"title\":\"Generate\",\"alias\":\"df_rewrite_pair_to_uniprot_names\",\"isInput\":false},{\"nodeId\":\"n_1790200001507_111933933\",\"type\":\"process\",\"title\":\"UniProt search\",\"branch\":\"