        "inputs": {
          "code": "def process(df):\n    # Same idea as uniprot_utils_v2.search_uniprot in the PhosphoLink repo: one REST query per\n    # name, keep the top hits, render them as a numbered block the prompt can index into.\n    import requests\n\n    def search(name):\n        r = requests.get(\n            \"https://rest.uniprot.org/uniprotkb/search\",\n            params={\"query\": name, \"size\": 3, \"fields\": \"id,accession,protein_name,gene_primary,organism_name\"},\n            timeout=30,\n        )\n        r.raise_for_status()\n        lines = []\n        for i, item in enumerate(r.json().get(\"results\", [])):\n            gene = (item.get(\"genes\") or [{}])[0].get(\"geneName\", {}).get(\"value\", \"\")\n            lines.append(\"[%d] %s | %s | %s | gene: %s | %s\" % (\n                i,\n                item.get(\"uniProtkbId\", \"\"),\n                item.get(\"primaryAccession\", \"\"),\n                item.get(\"proteinDescription\", {}).get(\"recommendedName\", {}).get(\"fullName\", {}).get(\"value\", \"\"),\n                gene,\n                item.get(\"organism\", {}).get(\"scientificName\", \"\"),\n            ))\n        return \"\\n\".join(lines)\n\n    out = pd.DataFrame({\n        \"PMID\": df[\"Input: PMID\"],\n        \"Title\": df[\"Input: Title\"],\n        \"Abstract\": df[\"Input: Abstract\"],\n        \"FullText\": df[\"Input: FullText\"],\n        \"kinase\": df[\"Output: kinase\"],\n        \"substrate\": df[\"Output: substrate\"],\n    })\n    out[\"kinase_candidates\"] = out[\"kinase\"].map(search)\n    out[\"substrate_candidates\"] = out[\"substrate\"].map(search)\n    return out",
